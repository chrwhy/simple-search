# simple-search 环境变量配置模板
# 复制此文件为 .env 并按需修改

# 数据库文件路径
SS_DB_PATH=example.db

# libsimple 库路径（留空则自动检测）
# SS_LIB_PATH=lib/darwin-amd64/libsimple.dylib

# 数据文件路径
SS_DATA_PATH=data/sample.json

# 标题表配置
SS_NAME_TABLE=docs_name
SS_NAME_TOKENIZER=simple

# 内容表配置
SS_CONTENT_TABLE=docs_content
SS_CONTENT_TOKENIZER=simple 0
